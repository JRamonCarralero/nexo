# Copy to backend/.env for local development (`make setup` does it for you).
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
# The API connects as nexo_api, which is not the owner of the tables, so
# Row-Level Security applies. Migrations use the owner (see Makefile DB_URL).
DATABASE_URL=postgres://nexo_api:nexo_api@localhost:5433/nexo?sslmode=disable

# Firebase Authentication. Locally the Auth emulator (make up) with the
# "demo-nexo" project: no real Firebase project or credentials needed.
FIREBASE_PROJECT_ID=demo-nexo
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Optional: makes sure the platform has a superadmin. The account is linked on
# its first login with a verified email.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@nexo.local
