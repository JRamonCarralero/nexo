# Public build-time settings (VITE_*). Nothing here is secret.
# In development you need none of them: the app defaults to the local
# Firebase Auth emulator (make up).

# Required in production builds:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# Needed for the Google popup in production:
# VITE_FIREBASE_AUTH_DOMAIN=

# Development only. A production build refuses to start with this set.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
